# ============================================================
# REQUIRED — the app won't start without these.
# ============================================================

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service-role key. Bypasses RLS; used only by server-side
# routes (the webhook, automation engine, and the public API key
# auth path — see docs/public-api.md). Keep this secret — never
# paste it into client code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# WhatsApp token encryption (64 hex chars = 32 bytes, AES-256-GCM).
ENCRYPTION_KEY=your-64-char-hex-key-here

# Meta App Secret
META_APP_SECRET=your-meta-app-secret

# ============================================================
# RECOMMENDED
# ============================================================
NEXT_PUBLIC_SITE_URL=https://crm.example.com
NEXT_PUBLIC_APP_LOCALE=en

# Shared secret protecting GET /api/automations/cron.
# AUTOMATION_CRON_SECRET=generate-a-long-random-string

# ============================================================
# SUTRAAPI FEATURE ADMIN
# ============================================================
# Protects /admin/features and the feature entitlement API.
# This is intentionally server-only and must never use NEXT_PUBLIC_.
SUTRAAPI_FEATURE_ADMIN_PASSWORD=generate-a-long-random-string

# ============================================================
# TAGMANGO
# ============================================================
# Used by the scheduled TagMango session sync and reminder worker.
# Client API keys are encrypted and stored per account in Supabase;
# this secret is only for the scheduler/webhook transport.
TAGMANGO_CRON_SECRET=generate-a-long-random-string

# Optional shared secret if you configure TagMango webhooks to send it.
# TAGMANGO_WEBHOOK_SECRET=generate-a-long-random-string

# ============================================================
# META TEMPLATE / DEVELOPMENT
# ============================================================
# META_APP_ID=your-meta-app-id
# WHATSAPP_TEMPLATES_DRY_RUN=true

# ============================================================
# AI reply assistant (optional)
# ============================================================
# AI_REQUEST_TIMEOUT_MS=30000
# AI_CONTEXT_MESSAGE_LIMIT=20
